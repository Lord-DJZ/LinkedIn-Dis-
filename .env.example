# Application Settings
PROJECT_NAME="Dullnit Candidate Discovery Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database & PostGIS (PostgreSQL 16 + PostGIS 3.4)
DATABASE_URL="postgresql://dullnit:dullnit_password@localhost:5432/dullnit_db"
# Test DB URL
TEST_DATABASE_URL="sqlite:///:memory:"

# Security & Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload & Storage
STORAGE_BACKEND="local"
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB

# AI Provider Configuration (Google Gemini)
AI_ENABLED=true
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
RUN_LIVE_AI_TESTS=false
